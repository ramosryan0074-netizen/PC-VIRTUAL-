{
  "name": "PC Virtual Ultra Performance",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 16,
    "memory": "64gb",
    "storage": "128gb"
  },
  "postCreateCommand": "echo 'PC Virtual ativado com sucesso! Pronto para processamento pesado.' && uname -a && lscpu"
}
